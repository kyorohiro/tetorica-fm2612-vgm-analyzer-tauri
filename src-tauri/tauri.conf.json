{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tetorica VGM Analyzer",
  "version": "0.50.3",
  "identifier": "net.tetorica.ym2612-vgm-analyzer",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "python3 scripts/import_release.py --check",
    "beforeBuildCommand": "python3 scripts/import_release.py --check"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Tetorica VGM Analyzer",
        "width": 1280,
        "height": 820,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
